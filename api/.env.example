# Copy to api/.env for local development. Never commit the real file.

TAIDI_DATABASE_URL=postgresql+asyncpg://taidi:taidi_dev@localhost:5433/taidi

# "dev": POST /auth/dev-login mints tokens locally, no external auth needed.
# "supabase": verify tokens against a real Supabase project instead.
TAIDI_AUTH_MODE=dev
TAIDI_DEV_JWT_SECRET=dev-only-insecure-secret-change-me

# Only used when TAIDI_AUTH_MODE=supabase — the project's JWT secret
# (Supabase dashboard -> Project Settings -> API -> JWT Secret).
# TAIDI_SUPABASE_JWT_SECRET=

TAIDI_CORS_ORIGINS=["http://localhost:3000"]
