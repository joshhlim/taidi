NEXT_PUBLIC_API_URL=http://localhost:8000

# Leave everything below unset for local dev — the app falls back to the
# dev-mode sign-in (any name, no external account) automatically.
#
# Set these three on the deployed app (Vercel) to switch on real accounts:
#   NEXT_PUBLIC_AUTH_MODE=supabase
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/public key from Supabase project settings>
